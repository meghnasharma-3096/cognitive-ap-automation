# Copy to .env  (never commit .env)

# Gemini key from https://aistudio.google.com/apikey. Server-side only.
# Without it the app still runs using an offline text parser (no scans/images).
GEMINI_API_KEY=

# Optional. Comma-separated, first available model wins.
# GEMINI_MODEL=gemini-3.8-flash,gemini-flash-latest

# Optional: gemini | fixture (replay tests/corpus) | rules (offline regex)
# LLM_PROVIDER=

# Three-way match price/total tolerance in dollars
# AP_TOLERANCE=5

# Below this extraction confidence (0-1) an invoice waits for human review
# AP_MIN_CONFIDENCE=0.75

# Optional overrides
# PORT=3000
# DB_PATH=data/db.json
# INBOX_DIR=data/inbox

# Reasoning effort: minimal | low (default) | medium | high | off. Lower = faster
# GEMINI_THINKING=low
