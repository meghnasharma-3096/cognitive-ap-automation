# .env.example
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# The Gemini API key is NOT set here — it lives server-side only, as the
# GEMINI_API_KEY secret on the `gemini-proxy` Supabase Edge Function
# (see supabase/functions/gemini-proxy). Without it, extraction falls
# back to mock data automatically.
